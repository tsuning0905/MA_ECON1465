a["taxes_paid_amt"] = a["taxes_paid"] * a["rate"]
 
# Correct TDM date errors
a.loc[a["date_TDM"] < td("2018-06-15"), "date_TDM"] = np.nan              # carto started 15 Jun
a.loc[(a["tmt"] == 3) & (a["date_TDM"] < td("2018-07-16")), "date_TDM"] = np.nan  # CLI started 15 Jul
 
# Missing carto date for an entire polygon: use "Zoom-in"'s last day of carto
# (the do-file overwrites every obs in these polygons, not only missing ones)
POLY_DATE = {112: "2018-11-28", 219: "2018-11-28", 224: "2018-11-29", 238: "2018-12-03",
             327: "2018-12-06", 343: "2018-11-30", 356: "2018-11-30", 510: "2018-12-03",
             512: "2018-12-03", 514: "2018-11-26", 533: "2018-11-28", 538: "2018-11-29",
             544: "2018-11-29", 588: "2018-11-27", 596: "2018-11-29", 658: "2018-11-27",
             664: "2018-11-28", 669: "2018-12-01", 678: "2018-11-29"}
for poly, d in POLY_DATE.items():
    a.loc[a["a7"] == poly, "today_carto"] = td(d)
 
# Missing some obs in the polygon: borrow from neighbouring compound codes
a = a.sort_values(["a7", "compound1"], kind="stable").reset_index(drop=True)
a["a7_rank"] = a.groupby("a7").cumcount() + 1
a["a7_max_rank"] = a.groupby("a7")["a7_rank"].transform("max")
tc = a["today_carto"]
same_next = a["a7"] == a["a7"].shift(-1)
same_prev = a["a7"] == a["a7"].shift(1)
a["today_carto_plus1"] = tc.shift(-1).where(same_next)
a["today_carto_minus1"] = tc.shift(1).where(same_prev)
 
def _fill(cond, src):
    a.loc[cond, "today_carto"] = a.loc[cond, src]
 
# conditions use the *un-grouped* previous/next row, as in the do-file
tc = a["today_carto"]; prv, nxt = tc.shift(1), tc.shift(-1)
_fill(tc.isna() & (prv == nxt) & prv.notna() & nxt.notna(), "today_carto_minus1")   # same
tc = a["today_carto"]; prv, nxt = tc.shift(1), tc.shift(-1)
diff = tc.isna() & (prv != nxt) & prv.notna() & nxt.notna()
_fill(diff & (a["a7_rank"] == a["a7_max_rank"]), "today_carto_minus1")              # last in polygon
tc = a["today_carto"]; prv, nxt = tc.shift(1), tc.shift(-1)
diff = tc.isna() & (prv != nxt) & prv.notna() & nxt.notna()
_fill(diff & (a["a7_rank"] != a["a7_max_rank"]), "today_carto_plus1")               # middle
 
