 # ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------
def td(s: str) -> int:
    """Stata td(15jun2018) -> Stata daily date integer."""
    return (pd.Timestamp(s) - STATA_EPOCH).days
 
 
def to_stata_date(x: pd.Series) -> pd.Series:
    """Parse a date/datetime column into Stata daily-date numbers (float, NaN if missing)."""
    d = pd.to_datetime(x, errors="coerce").dt.normalize()
    return (d - STATA_EPOCH).dt.days.astype("float")
 
 
def stata_to_datetime(x: pd.Series) -> pd.Series:
    return STATA_EPOCH + pd.to_timedelta(x, unit="D")
 
 
def st_gt(x: pd.Series, v) -> pd.Series:
    """Stata `x > v`: missing counts as +infinity, so missing > v is True."""
    return x.isna() | (x > v)
 
 
def st_eq(a: pd.Series, b: pd.Series) -> pd.Series:
    """Stata `a == b` for numerics: missing == missing is True."""
    return (a == b) | (a.isna() & b.isna())
 
 
def read_optional(name: str, **kw) -> pd.DataFrame | None:
    """Read <name> (.csv/.dta/.xlsx) from DATA_DIR if it exists, else warn and return None."""
    p = DATA_DIR / name
    if not p.exists():
        warnings.warn(f"[missing input] {name} not found - skipped", stacklevel=2)
        return None
    if p.suffix == ".csv":
        return pd.read_csv(p, low_memory=False, **kw)
    if p.suffix == ".dta":
        return pd.read_stata(p, convert_categoricals=False, **kw)
    if p.suffix == ".xlsx":
        return pd.read_excel(p, **kw)
    raise ValueError(p)
 
 
def read_csv(name: str) -> pd.DataFrame:
    return pd.read_csv(DATA_DIR / name, low_memory=False)
 
 
def clean_str(s: pd.Series) -> pd.Series:
    """Stata string semantics: missing string is ''."""
    return s.astype("object").where(s.notna(), "").astype(str)
 
 
def stata_merge(master: pd.DataFrame, using: pd.DataFrame, on: str,
                validate: str) -> pd.DataFrame:
    """Replicates `merge <validate> <on> using ...` (outer join, master values
    win for overlapping variables, _merge coded 1/2/3)."""
    shared = [c for c in using.columns if c in master.columns and c != on]
    # pandas would match NaN keys to each other; Stata's 1:1/m:1 merges in this
    # do-file never have missing keys on the using side, so guard against it.
    using = using[using[on].notna()]
    # Rows with a missing key (polygon-only rows created by the m:1 polygon
    # merges) cannot match anything: keep them as master-only.
    nokey = master[master[on].isna()]
    master = master[master[on].notna()]
    m = master.merge(using, on=on, how="outer", suffixes=("", "__using"),
                     validate=validate, indicator=True)
    m["_merge"] = m["_merge"].map({"left_only": 1, "right_only": 2, "both": 3}).astype(int)
    for c in shared:
        uc = f"{c}__using"
        m[c] = np.where(m["_merge"] == 2, m[uc], m[c])
        m = m.drop(columns=uc)
    if len(nokey):
        m = pd.concat([m, nokey.assign(_merge=1)], ignore_index=True)
    return m
 
 
def ensure_cols(df: pd.DataFrame, cols, fill=np.nan) -> pd.DataFrame:
    for c in cols:
        if c not in df.columns:
            df[c] = fill
    return df
 
 
